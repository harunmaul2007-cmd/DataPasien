# Salin menjadi android/keystore.properties (TIDAK dikomit, sudah di .gitignore).
# Simpan file .jks di luar repositori. Path relatif diselesaikan terhadap direktori android/.
# Alternatif: variabel lingkungan DATAPASIEN_KEYSTORE_FILE, DATAPASIEN_KEYSTORE_PASSWORD,
# DATAPASIEN_KEYSTORE_ALIAS, DATAPASIEN_KEYSTORE_KEY_PASSWORD.
storeFile=C:/path/di/luar/repo/datapasien-release.jks
storePassword=GANTI_DENGAN_PASSWORD_STORE
keyAlias=datapasien
keyPassword=GANTI_DENGAN_PASSWORD_KEY
